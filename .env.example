# LLM Provider: "ollama" (free, local), "openrouter" (free/paid cloud), or "openai" (paid cloud)
LLM_PROVIDER=

# OpenRouter API key (only needed when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL= #openrouter/free

# OpenAI API key (only needed when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=

# Ollama model (only needed when LLM_PROVIDER=ollama)
OLLAMA_MODEL=

# Local embedding model (used for all providers)
EMBEDDING_MODEL= #ibm-granite/granite-embedding-311m-multilingual-r2

# Vector store persistence directory
CHROMA_PERSIST_DIR=./chroma_db

# Text chunking parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Number of retrieved chunks per query
K_RETRIEVAL=5
