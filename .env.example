# LLM Provider: "ollama" (free, local), "openrouter" (free/paid cloud), or "openai" (paid cloud)
LLM_PROVIDER=

# OpenRouter API key (only needed when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# OpenAI API key (only needed when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=

# Ollama model (only needed when LLM_PROVIDER=ollama)
OLLAMA_MODEL=

# Embedding backend: "huggingface" (runs in-process, no external service) or
# "ollama" (requires Ollama running)
EMBEDDING_PROVIDER=
# Embedding model. For "huggingface", a HuggingFace model id; intfloat/multilingual-e5-base
# is multilingual and retrieval-tuned (query/passage prefixes are applied automatically).
# For "ollama", an Ollama embedding model, e.g. qwen3-embedding:0.6b
EMBEDDING_MODEL=

# Vector store persistence directory
CHROMA_PERSIST_DIR=./chroma_db

# Text chunking parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Number of retrieved chunks per query
K_RETRIEVAL=5
